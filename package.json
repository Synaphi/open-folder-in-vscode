{
  "name": "open-folder-in-vscode",
  "version": "1.0.0",
  "description": "Right-click one folder, or several folders, and open them in Visual Studio Code. Several folders open as one multi-root workspace.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "npm run build && node smoke.cjs",
    "lint": "eslint ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.8",
    "eslint": "^9.35.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
